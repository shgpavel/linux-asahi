/*
 * Apple Mac mini (M4, 2024)
 *
 * target-type: J773g
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";

	aliases {
		atcphy2 = &atcphy2;
		bluetooth0 = &bluetooth0;
		ethernet0 = &ethernet0;
		wifi0 = &wifi0;
	};
};

/*
 * The front USB-C ports hang off an onboard USB 3 hub on the third
 * controller, with no Type-C controller in between.
 */
&pinctrl_ap {
	/*
	 * iBoot leaves the hub in reset. It loads its firmware from a flash
	 * shared with spi3 when it leaves reset with the flash enabled.
	 */
	usb_hub_oe-hog {
		gpio-hog;
		gpios = <101 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-flash-oe";
	};

	usb_hub_rst-hog {
		gpio-hog;
		gpios = <198 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "usb-hub-rst";
	};
};

&atcphy2 {
	apple,fixed-mode = "usb3";
	status = "okay";
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	/delete-property/ role-switch-default-mode;
	status = "okay";
};

&port00 {
	/* WLAN/BT, BCM4388 */
	bus-range = <1 1>;
	pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
	status = "okay";

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
		brcm,board-type = "apple,sakhalin";
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-bd-address = [00 00 00 00 00 00];
		brcm,board-type = "apple,sakhalin";
	};
};

&pcie0_dart {
	status = "okay";
};

&port02 {
	/* 1 Gbit Ethernet, BCM57762 */
	status = "okay";

	ethernet0: ethernet@0,0 {
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 00];
	};
};

&pcie2_dart {
	status = "okay";
};

&dptxphy {
	status = "okay";
};

&dcp {
	apple,connector-type = "HDMI-A";
	hdmi-hpd-gpios = <&pinctrl_aop 41 GPIO_ACTIVE_HIGH>;
	phys = <&dptxphy>;
	phy-names = "dp-phy";
	apple,dptx-phy = <4>;
};

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_disp_cpu>, <&ps_dptx_phy>;
};

#include "hwmon-common.dtsi"
#include "hwmon-mini.dtsi"

&smc_hwmon {
	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "CPU Max Temperature";
	};
};
