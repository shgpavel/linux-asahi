/*
 * Apple Mac mini (M4, 2024)
 *
 * target-type: J773g
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";

	aliases {
		atcphy2 = &atcphy2;
		ethernet0 = &ethernet0;
	};
};

/*
 * The front USB-C ports hang off an onboard USB 3 hub on the third
 * controller, with no Type-C controller in between.
 */
&pinctrl_ap {
	/*
	 * iBoot leaves the hub in reset. It loads its firmware from a flash
	 * shared with spi3 when it leaves reset with the flash enabled.
	 */
	usb_hub_oe-hog {
		gpio-hog;
		gpios = <101 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-flash-oe";
	};

	usb_hub_rst-hog {
		gpio-hog;
		gpios = <198 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "usb-hub-rst";
	};
};

&atcphy2 {
	apple,fixed-mode = "usb3";
	status = "okay";
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	/delete-property/ role-switch-default-mode;
	status = "okay";
};

&port02 {
	/* 1 Gbit Ethernet, BCM57762 */
	status = "okay";

	ethernet0: ethernet@0,0 {
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 00];
	};
};

&pcie2_dart {
	status = "okay";
};

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_disp_cpu>, <&ps_dptx_phy>;
};
