/dts-v1/;

#include "t8132.dtsi"
#include "t8132-jxxx.dtsi"

/ {
	compatible = "apple,j773g", "apple,t8132", "apple,arm-platform";
	model = "Apple Mac mini (M4, 2024)";

	aliases {
		atcphy0 = &atcphy0;
		atcphy1 = &atcphy1;
		atcphy2 = &atcphy2;
		atcphy3 = &atcphy3;
		bluetooth0 = &bluetooth0;
		ethernet0 = &ethernet0;
		wifi0 = &wifi0;
	};
};

/*
 * The front USB-C ports hang off an onboard USB 3 hub on the third
 * controller, with no Type-C controller in between.
 */
&pinctrl_ap {
	/*
	 * iBoot leaves the hub in reset. It loads its firmware from a flash
	 * shared with spi3 when it leaves reset with the flash enabled.
	 */
	usb_hub_oe-hog {
		gpio-hog;
		gpios = <101 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "usb-hub-flash-oe";
	};

	usb_hub_rst-hog {
		gpio-hog;
		gpios = <198 GPIO_ACTIVE_LOW>;
		output-low;
		line-name = "usb-hub-rst";
	};
};

&atcphy2 {
	apple,fixed-mode = "usb3";
	status = "okay";
};

&dwc3_2_dart_0 {
	status = "okay";
};

&dwc3_2_dart_1 {
	status = "okay";
};

&dwc3_2 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	/delete-property/ role-switch-default-mode;
	status = "okay";
};

/*
 * The back USB-C ports: a Type-C controller on SPMI, a Type-C PHY and a
 * DWC3 each. USB only for now; Thunderbolt and DisplayPort need ACIO.
 */
&nub_spmi_a0 {
	status = "okay";

	hpm3: usb-pd@8 {
		compatible = "apple,sn201202x";
		reg = <0x8 SPMI_USID>;
		interrupts = <63 IRQ_TYPE_EDGE_RISING>,
			     <65 IRQ_TYPE_EDGE_RISING>,
			     <69 IRQ_TYPE_EDGE_RISING>,
			     <71 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec3: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back Right";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec3_connector_hs: endpoint {
						remote-endpoint = <&dwc3_3_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec3_connector_ss: endpoint {
						remote-endpoint = <&atcphy3_typec_lanes>;
					};
				};
			};
		};
	};

	hpm1: usb-pd@a {
		compatible = "apple,sn201202x";
		reg = <0xa SPMI_USID>;
		interrupts = <37 IRQ_TYPE_EDGE_RISING>,
			     <39 IRQ_TYPE_EDGE_RISING>,
			     <43 IRQ_TYPE_EDGE_RISING>,
			     <45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec1: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back Left";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec1_connector_hs: endpoint {
						remote-endpoint = <&dwc3_1_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec1_connector_ss: endpoint {
						remote-endpoint = <&atcphy1_typec_lanes>;
					};
				};
			};
		};
	};

	hpm0: usb-pd@c {
		compatible = "apple,sn201202x";
		reg = <0xc SPMI_USID>;
		interrupts = <11 IRQ_TYPE_EDGE_RISING>,
			     <13 IRQ_TYPE_EDGE_RISING>,
			     <17 IRQ_TYPE_EDGE_RISING>,
			     <19 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "irq", "select", "sleep", "wake";

		typec0: connector {
			compatible = "usb-c-connector";
			label = "USB-C Back Middle";
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec0_connector_hs: endpoint {
						remote-endpoint = <&dwc3_0_hs>;
					};
				};

				port@1 {
					reg = <1>;
					typec0_connector_ss: endpoint {
						remote-endpoint = <&atcphy0_typec_lanes>;
					};
				};
			};
		};
	};
};

&atcphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy0_typec_lanes: endpoint {
				remote-endpoint = <&typec0_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;
			atcphy0_usb3: endpoint {
				remote-endpoint = <&dwc3_0_ss>;
			};
		};
	};
};

&dwc3_0_dart_0 {
	status = "okay";
};

&dwc3_0_dart_1 {
	status = "okay";
};

&dwc3_0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_0_hs: endpoint {
				remote-endpoint = <&typec0_connector_hs>;
			};
		};

		port@1 {
			reg = <1>;
			dwc3_0_ss: endpoint {
				remote-endpoint = <&atcphy0_usb3>;
			};
		};
	};
};

&atcphy1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy1_typec_lanes: endpoint {
				remote-endpoint = <&typec1_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;
			atcphy1_usb3: endpoint {
				remote-endpoint = <&dwc3_1_ss>;
			};
		};
	};
};

&dwc3_1_dart_0 {
	status = "okay";
};

&dwc3_1_dart_1 {
	status = "okay";
};

&dwc3_1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_1_hs: endpoint {
				remote-endpoint = <&typec1_connector_hs>;
			};
		};

		port@1 {
			reg = <1>;
			dwc3_1_ss: endpoint {
				remote-endpoint = <&atcphy1_usb3>;
			};
		};
	};
};

&atcphy3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			atcphy3_typec_lanes: endpoint {
				remote-endpoint = <&typec3_connector_ss>;
			};
		};

		port@1 {
			reg = <1>;
			atcphy3_usb3: endpoint {
				remote-endpoint = <&dwc3_3_ss>;
			};
		};
	};
};

&dwc3_3_dart_0 {
	status = "okay";
};

&dwc3_3_dart_1 {
	status = "okay";
};

&dwc3_3 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dwc3_3_hs: endpoint {
				remote-endpoint = <&typec3_connector_hs>;
			};
		};

		port@1 {
			reg = <1>;
			dwc3_3_ss: endpoint {
				remote-endpoint = <&atcphy3_usb3>;
			};
		};
	};
};

&port00 {
	/* WLAN/BT, BCM4388 */
	bus-range = <1 1>;
	pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
	status = "okay";

	wifi0: wifi@0,0 {
		compatible = "pci14e4,4434";
		reg = <0x10000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 00 00 00 00 00];
		apple,antenna-sku = "XX";
		brcm,board-type = "apple,sakhalin";
	};

	bluetooth0: bluetooth@0,1 {
		compatible = "pci14e4,5f72";
		reg = <0x10100 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-bd-address = [00 00 00 00 00 00];
		brcm,board-type = "apple,sakhalin";
	};
};

&pcie0_dart {
	status = "okay";
};

&port02 {
	/* 1 Gbit Ethernet, BCM57762 */
	status = "okay";

	ethernet0: ethernet@0,0 {
		reg = <0x20000 0x0 0x0 0x0 0x0>;
		/* To be filled by the loader */
		local-mac-address = [00 10 18 00 00 00];
	};
};

&pcie2_dart {
	status = "okay";
};

&dptxphy {
	status = "okay";
};

&dcp {
	apple,connector-type = "HDMI-A";
	hdmi-hpd-gpios = <&pinctrl_aop 41 GPIO_ACTIVE_HIGH>;
	phys = <&dptxphy>;
	phy-names = "dp-phy";
	apple,dptx-phy = <4>;
};

/*
 * Keep the power-domains used for the HDMI port on.
 */
&framebuffer0 {
	power-domains = <&ps_disp_cpu>, <&ps_dptx_phy>;
};

#include "hwmon-common.dtsi"
#include "hwmon-mini.dtsi"

&smc_hwmon {
	temperature-TCMz {
		apple,key-id = "TCMz";
		label = "CPU Max Temperature";
	};
};

&admac {
	status = "okay";
};

&i2c1 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_nub 17 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <98 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		cirrus,ts-inv = <1>;
		sound-name-prefix = "Jack";
	};
};

&i2c3 {
	status = "okay";

	speaker_amp: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		shutdown-gpios = <&pinctrl_ap 15 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&pinctrl_ap>;
		interrupts = <14 IRQ_TYPE_LEVEL_LOW>;
		#sound-dai-cells = <0>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};
};

&mca {
	status = "okay";
};

/ {
	sound {
		compatible = "apple,j773g-macaudio", "apple,macaudio";
		model = "Mac mini J773g";

		dai-link@0 {
			link-name = "Speaker";

			cpu {
				sound-dai = <&mca 0>;
			};
			codec {
				sound-dai = <&speaker_amp>;
			};
		};

		dai-link@1 {
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&mca 2>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};
	};
};

